{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xiadan-moban",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "xiadan.wandalink.com",
      "zone_name": "wandalink.com",
      "custom_domain": true
    }
  ]
}
